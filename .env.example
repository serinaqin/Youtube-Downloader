# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-west-1
S3_BUCKET_NAME=youdescribe-downloaded-youtube-videos

# Local download directory
DOWNLOAD_DIR=~/Downloads/YouDescribeDownloadedVideos

# API callback URL (YouDescribeX-API backend)
API_CALLBACK_URL=http://localhost:4001

# Server port
PORT=8001

# Failure email alerts via AWS SNS (set your topic ARN; leave empty to disable)
SNS_TOPIC_ARN=your_sns_topic_arn
NOTIFY_COOLDOWN_SECONDS=1800
